flowchart TD
    classDef default fill:#f9fafb,stroke:#e5e7eb,stroke-width:1px,color:#111827;
    classDef orchestrator fill:#f3f4f6,stroke:#d1d5db,stroke-width:2px,color:#111827;
    classDef agent fill:#ffffff,stroke:#9ca3af,stroke-width:1px,color:#111827,rx:8,ry:8;
    classDef queue fill:#eef2ff,stroke:#6366f1,stroke-width:2px,color:#4f46e5;
    classDef output fill:#f0fdf4,stroke:#22c55e,stroke-width:2px,color:#166534;

    Input[Filmmaker Query / Upload]:::output --> Orchestrator
    
    subgraph Orchestrator [Orchestrator - Google ADK]
        direction LR
        Desk[Producer Desk Agent<br/>LlmAgent]:::agent --> Disambig[Disambiguator Agent<br/>Cloud Tasks]:::agent
        Disambig --> Planner[Planner Agent<br/>LlmAgent]:::agent
    end
    Orchestrator:::orchestrator
    
    Orchestrator --> Queue[Google Cloud Tasks Queue]:::queue
    
    Queue --> DeepVetting
    
    subgraph DeepVetting [Deep Vetting - Parallel Search]
        direction TB
        Fest[FestivalAgent]:::agent
        Org[OrganizerAgent]:::agent
        Part[ParticipantsAgent]:::agent
    end
    DeepVetting:::orchestrator
    
    DeepVetting --> Analysis
    
    subgraph Analysis [Analysis & Drafting]
        direction TB
        Claim[ClaimExtractorAgent]:::agent
        Contra[ContradictionAgent]:::agent
        Report[ReportWriterAgent]:::agent
    end
    Analysis:::orchestrator
    
    Analysis --> Output[Evidence Dossier UI / Export]:::output
