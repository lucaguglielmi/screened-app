clients: "1. CLIENTS & MULTI-AGENT RUNTIMES" {
  class: tier_clients
  grid-columns: 3
  grid-gap: 20

  web: |md
    ### Filmmaker Web Studio
    - **React 19 + Tailwind v4 + Vite**
    - Real-time SSE Investigation Stream
    - Transparency Radar & Claim Ledger
    - Visual DOM Telemetry Target
  | { class: card_blue }

  webmcp_agent: |md
    ### Autonomous In-Browser Agents
    - **Chrome WebMCP / Gemini Live**
    - DOM Event Bus: `window.__screened_web_mcp__`
    - Live Agent Co-Browsing & Form Sync
    - Element Spotlighting & Mutation Observer
  | { class: card_blue }

  headless: |md
    ### Headless Agents & IDEs
    - **Google Antigravity / Cursor / Claude Code**
    - Standard Open JSON-RPC 2.0 Clients
    - Autonomous CI/CD Pipeline Audits
    - Verification & Anti-Predatory Scans
  | { class: card_blue }
}

gateway: "2. INGESTION & DUAL-PROTOCOL GATEWAY" {
  class: tier_gateway
  grid-columns: 3
  grid-gap: 20

  webmcp_bus: |md
    ### In-Browser WebMCP Engine
    - WebMCP 2026 In-DOM Protocol Hub
    - Events: `webmcp:call` / `webmcp:result`
    - Dynamic Tool Discovery & Registration
    - Zero-Network Client Tool Isolation
  | { class: card_blue }

  api_gw: |md
    ### FastAPI Application Gateway
    - High-Performance Async ASGI Hub
    - REST Endpoints & SSE Streaming Broker
    - Zero-PII Scrubbing & Regex Masking Vault
    - Action Sandbox Gate (SHA-256 Approvals)
  | { class: card_blue }

  server_mcp: |md
    ### Headless Server MCP
    - Open MCP Protocol JSON-RPC 2.0
    - SSE Transport: `/api/mcp/sse`
    - Message Gateway: `/api/mcp/messages`
    - Stdio Protocol Adapter for External IDEs
  | { class: card_blue }
}

adk: "3. COGNITIVE MULTI-AGENT ORCHESTRATOR (Google ADK)" {
  class: tier_adk
  grid-columns: 4
  grid-gap: 16

  producer: |md
    ### Producer Desk
    *(LlmAgent)*
    - Conversational Intake & Triage
    - Dynamic Mini-UI Synthesis
    - Lead Investigation Coordinator
    - Filmmaker Outreach Packaging
  | { class: card_purple }

  disam_plan: |md
    ### Disambiguate & Plan
    *(LlmAgent Cluster)*
    - **DisambiguatorAgent**: Entity Normalization
    - **PlannerAgent**: 3-Vector Strategy
    - Dynamic Domain Task Formulation
    - OpportunityScoutAgent (Grants & Calls)
  | { class: card_purple }

  vetting: |md
    ### Deep Vetting Cluster
    *(ParallelAgent)*
    - **FestivalAgent**: Leases, Rules & Fees
    - **OrganizerAgent**: Companies House Filings
    - **ParticipantsAgent**: Community & Jury
    - High-Concurrency Parallel Execution
  | { class: card_purple }

  synthesis: |md
    ### Analysis & Synthesis
    *(SequentialAgent)*
    - **ClaimExtractor**: Atomic Citations
    - **ContradictionAnalyst**: Collisions
    - **ReportWriter**: 4-Tier Dossier
    - Cryptographic SHA-256 Radar Seal
  | { class: card_purple }
}

engines: "4. DUAL FOUNDATION ENGINES (Reasoning & Evidence)" {
  class: tier_engines
  grid-columns: 2
  grid-gap: 24

  gemini: |md
    ### Vertex AI — Gemini Reasoning Engine
    - **Gemini 2.5 Pro**: Complex multi-step contradiction deduction, high-order reasoning, structured JSON Schema output, multimodal PDF intake.
    - **Gemini 2.5 Flash**: Sub-second entity disambiguation, low-latency conversational triage, high-throughput streaming responses.
    - **Pydantic Validation**: Native function calling with strict schema enforcement across all agent tools.
  | { class: card_amber }

  parallel: |md
    ### Parallel API — Ground-Truth Evidence Engine
    - **Parallel Search**: Dual-speed discovery (`fast` 700ms at $1/1k for preflight vs `advanced` multi-hop deep crawl).
    - **Parallel Extract**: Verbatim quote extraction with cryptographic SHA-256 source hashing.
    - **Parallel Task API**: Asynchronous cloud workers for exhaustive investigations.
    - **Parallel Monitor**: Autonomous web change detection with HMAC-SHA256 drift verification.
  | { class: card_emerald }
}

infra: "5. PRODUCTION CLOUD INFRASTRUCTURE (Google Cloud Platform)" {
  class: tier_infra
  grid-columns: 4
  grid-gap: 16

  cloud_run: |md
    ### Google Cloud Run
    - Serverless FastAPI Container
    - Auto-Scale 0 to N Instances
    - Region: London (`europe-west2`)
    - Zero Cold-Start Concurrency
  | { class: card_slate }

  cloud_tasks: |md
    ### Google Cloud Tasks
    - `screened-tasks` Queue
    - Durable Async Worker Offload
    - OIDC Authenticated Tasks
    - Automatic Exponential Backoff
  | { class: card_slate }

  firestore: |md
    ### Cloud Firestore
    - Atomic Claims Ledger
    - State Machine Persistence
    - Real-time Mutation Sync
    - Zero PII Encrypted Store
  | { class: card_slate }

  observability: |md
    ### Security & Tracing
    - Cloud Secret Manager Key Vault
    - OpenTelemetry Distributed Spans
    - Cloud Trace Latency Profiling
    - Structured Cloud Logging
  | { class: card_slate }
}

