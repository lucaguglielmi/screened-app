# Parallel API Key (Required for Parallel Search runtime integration)
PARALLEL_API_KEY=your_parallel_api_key_here

# Google Cloud & Vertex AI Configuration
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=screened-hackathon
GOOGLE_CLOUD_LOCATION=europe-west2

# Session & Security Configuration
SESSION_SIGNING_KEY=generate_with_openssl_rand_base64_48

# Web Push Notification VAPID Keys (Optional for local dev)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:admin@screened.dev

# Server & Port
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
